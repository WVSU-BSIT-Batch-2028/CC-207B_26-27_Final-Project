# Copy to .env.local and fill in. All VITE_ values ship to the browser, so only
# put PUBLIC keys here (never a Supabase service-role key or an Anthropic key).

# Supabase project (Settings -> API). Leave blank to run on labeled DEMO data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# MapTiler Cloud key. Restrict allowed origins in the MapTiler dashboard.
# Leave blank to get the labeled "campus overlay only" map.
VITE_MAPTILER_KEY=
