<?xml version="1.0" encoding="utf-8"?>
<!-- Debug build-variant network security configuration.
     Merged only into debug builds; ignored automatically in release builds. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
